{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacMovieMaker",
  "version": "0.1.0",
  "identifier": "com.macmoviemaker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Untitled Project — MacMovieMaker",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "resources": [
      "binaries/ffmpeg-aarch64-apple-darwin",
      "binaries/ffmpeg-x86_64-apple-darwin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
